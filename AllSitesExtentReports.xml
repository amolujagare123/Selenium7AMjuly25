<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Website Categories Suite">

    <listeners>
        <listener class-name="ListenersDemo.MyExtentListeners"/>
    </listeners>


    <!-- Social Media & AI Test -->
    <test name="Social Media and AI Sites">
        <classes>
            <class name="TestNG.RealTestsWithExtentReports.SocialSites"/>
            <class name="TestNG.RealTestsWithExtentReports.AISites"/>
        </classes>
    </test>

    <!-- Career & Learning Test -->
    <test name="Job and Tutorial Sites">
        <classes>
            <class name="TestNG.RealTestsWithExtentReports.JobSites"/>
            <class name="TestNG.RealTestsWithExtentReports.TutorialSites"/>
        </classes>
    </test>

</suite>